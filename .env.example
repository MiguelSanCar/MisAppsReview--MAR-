# Copia este fichero a .env y rellena los valores (nunca subas .env al repositorio).
PORT=3001
# Claves de APIs externas (gratuitas): TMDB (series y películas) y OMDb (puntuaciones IMDb y Rotten Tomatoes)
TMDB_API_KEY=
OMDB_API_KEY=
# País para la disponibilidad en plataformas de streaming (búsqueda avanzada)
# TMDB_REGION=ES

# --- Producción (ver docs/DESPLIEGUE.md) ---
# JWT_SECRET=cadena-larga-aleatoria     (obligatorio con NODE_ENV=production)
# PUBLIC_URL=https://tu-dominio
# CLIENT_ORIGIN=https://tu-dominio
# DB_FILE=/data/mar.db
# USE_REAL_RUNTIME=false                (true = duración real de las APIs)
# JOINT_HISTORY_LIMIT=50                (mínimo 15)

# Red corporativa con inspección HTTPS: ruta al PEM de la CA de la empresa (por defecto certs/corporate-ca.pem si existe)
# EXTRA_CA_CERTS=certs/corporate-ca.pem

# --- Correo SMTP (base lista, sin usar todavía; probar con: npm run mail:test -w server -- tu@correo.com) ---
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false          (true para el puerto 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MAR <no-reply@tu-dominio>

# --- Listas conjuntas ---
# JOINT_INACTIVITY_DAYS=60   (se borran tras este tiempo sin actividad)
# JOINT_WARNING_DAYS=15      (aviso con esta antelación)

# --- Fuentes externas ---
# JIKAN_ENABLED=false        (no consultar Jikan/MyAnimeList: útil si la red lo bloquea)
# TMDB_SOFT_MS=6000          (cuánto espera la búsqueda a TMDB)
# JIKAN_SOFT_MS=2000         (cuánto espera la búsqueda a Jikan)
# PROVIDER_DOWN_MS=60000     (primera pausa tras un fallo; se duplica hasta PROVIDER_DOWN_MAX_MS=900000)
