# Copia este fichero a .env y rellena los valores (nunca subas .env al repositorio).
PORT=3001
# Claves de APIs externas (gratuitas): TMDB (series y películas), OMDb (puntuaciones IMDb y Rotten Tomatoes)
# y el Client ID de MyAnimeList (anime; se crea en https://myanimelist.net/apiconfig)
TMDB_API_KEY=
OMDB_API_KEY=
MAL_CLIENT_ID=
# País para la disponibilidad en plataformas de streaming (búsqueda avanzada)
# TMDB_REGION=ES

# --- Producción (ver docs/DESPLIEGUE.md) ---
# JWT_SECRET=cadena-larga-aleatoria     (obligatorio con NODE_ENV=production)
# PUBLIC_URL=https://tu-dominio
# CLIENT_ORIGIN=https://tu-dominio
# DB_FILE=/data/mar.db
# USE_REAL_RUNTIME=true                 (false = duraciones fijas 50 / 90 / 23 min)
# RUNTIME_SAMPLE=4                      (episodios de muestra por temporada larga o por serie)
# RUNTIME_MAX_FETCH=12                  (peticiones máximas a TMDB por serie)
# RUNTIME_CONCURRENCY=2                 (peticiones simultáneas globales)
# JOINT_HISTORY_LIMIT=50                (mínimo 15)

# Red corporativa con inspección HTTPS: ruta al PEM de la CA de la empresa (por defecto certs/corporate-ca.pem si existe)
# EXTRA_CA_CERTS=certs/corporate-ca.pem

# --- Correo SMTP (base lista, sin usar todavía; probar con: npm run mail:test -w server -- tu@correo.com) ---
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false          (true para el puerto 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MAR <no-reply@tu-dominio>

# --- Listas conjuntas ---
# JOINT_INACTIVITY_DAYS=60   (se borran tras este tiempo sin actividad)
# JOINT_WARNING_DAYS=15      (aviso con esta antelación)

# --- Fuentes externas ---
# TMDB_SOFT_MS=6000          (cuánto espera la búsqueda a TMDB)
# MAL_SOFT_MS=3000           (cuánto espera la búsqueda a MyAnimeList)
# IMPORT_RATE_LIMIT=10       (importaciones de MyAnimeList por persona cada 15 minutos)
# PROVIDER_DOWN_MS=60000     (primera pausa tras un fallo; se duplica hasta PROVIDER_DOWN_MAX_MS=900000)

# --- Novedades (campana de notificaciones); valores por defecto ---
# NEWS_TTL_ACTIVE_MS=43200000     (series en emisión: se revisan cada 12 h)
# NEWS_TTL_IDLE_MS=604800000      (series terminadas y películas: cada 7 días)
# NEWS_BUDGET=30                  (contenidos consultados por ronda)
# NEWS_CONCURRENCY=3              (peticiones simultáneas a TMDB, límite global)
# NEWS_USER_INTERVAL_MS=1800000   (refresco por persona: como mucho cada 30 min)
